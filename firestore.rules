rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validation and ID poisoning protection
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['id', 'nombre', 'apellido', 'numeroCamiseta', 'posicion', 'categoria'])
        && data.id is string
        && data.nombre is string && data.nombre.size() <= 100
        && data.apellido is string && data.apellido.size() <= 100
        && data.numeroCamiseta is int
        && data.posicion in ['Arquera', 'Defensora', 'Volante', 'Delantera']
        && data.categoria in ['7ma', '6ta', '5ta', 'Intermedia', 'Primera'];
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['id', 'fecha', 'hora', 'rival', 'categoria', 'esLocal', 'estado'])
        && data.id is string
        && data.fecha is string
        && data.hora is string
        && data.rival is string && data.rival.size() <= 100
        && data.categoria in ['7ma', '6ta', '5ta', 'Intermedia', 'Primera']
        && data.esLocal is bool
        && data.estado in ['Programado', 'En juego', 'Finalizado', 'Suspendido'];
    }

    function isValidStanding(data) {
      return data.keys().hasAll(['id', 'equipo', 'pj', 'pg', 'pe', 'pp', 'gf', 'gc', 'dg', 'pts', 'categoria'])
        && data.id is string
        && data.equipo is string
        && data.pj is int
        && data.pg is int
        && data.pe is int
        && data.pp is int
        && data.gf is int
        && data.gc is int
        && data.dg is int
        && data.pts is int
        && data.categoria in ['7ma', '6ta', '5ta', 'Intermedia', 'Primera'];
    }

    function isValidNewsItem(data) {
      return data.keys().hasAll(['id', 'titulo', 'contenido', 'fecha', 'autor'])
        && data.id is string
        && data.titulo is string && data.titulo.size() <= 200
        && data.contenido is string && data.contenido.size() <= 10000
        && data.fecha is string
        && data.autor is string;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['id', 'titulo', 'imagenUrl', 'fecha', 'torneo'])
        && data.id is string
        && data.titulo is string && data.titulo.size() <= 200
        && data.imagenUrl is string
        && data.fecha is string
        && data.torneo is string;
    }

    function isValidConvocation(data) {
      return data.keys().hasAll(['id', 'fecha', 'rival', 'categoria', 'estadosJugadoras'])
        && data.id is string
        && data.fecha is string
        && data.rival is string && data.rival.size() <= 100
        && data.categoria in ['7ma', '6ta', '5ta', 'Intermedia', 'Primera']
        && data.estadosJugadoras is map;
    }

    function isValidNotificationLog(data) {
      return data.keys().hasAll(['id', 'titulo', 'cuerpo', 'fecha', 'tipo'])
        && data.id is string
        && data.titulo is string && data.titulo.size() <= 200
        && data.cuerpo is string && data.cuerpo.size() <= 1000
        && data.fecha is string
        && data.tipo in ['noticia', 'resultado', 'horario', 'convocatoria'];
    }

    function isValidSettings(data) {
      return data.id is string && data.id.size() <= 128
        && (!('value' in data) || (data.value is string && data.value.size() <= 5000000))
        && (!('name' in data) || (data.name is string && data.name.size() <= 200))
        && (!('fotoUrl' in data) || (data.fotoUrl is string && data.fotoUrl.size() <= 2000));
    }

    // Default catch-all rule: Deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicit structural paths for each collection matching the blueprint
    match /players/{playerId} {
      allow read: if true;
      allow create, update: if isValidId(playerId) && isValidPlayer(request.resource.data);
      allow delete: if isValidId(playerId);
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create, update: if isValidId(matchId) && isValidMatch(request.resource.data);
      allow delete: if isValidId(matchId);
    }

    match /standings/{standingId} {
      allow read: if true;
      allow create, update: if isValidId(standingId) && isValidStanding(request.resource.data);
      allow delete: if isValidId(standingId);
    }

    match /news/{newsId} {
      allow read: if true;
      allow create, update: if isValidId(newsId) && isValidNewsItem(request.resource.data);
      allow delete: if isValidId(newsId);
    }

    match /gallery/{galleryId} {
      allow read: if true;
      allow create, update: if isValidId(galleryId) && isValidGalleryItem(request.resource.data);
      allow delete: if isValidId(galleryId);
    }

    match /convocations/{convocationId} {
      allow read: if true;
      allow create, update: if isValidId(convocationId) && isValidConvocation(request.resource.data);
      allow delete: if isValidId(convocationId);
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isValidId(notificationId) && isValidNotificationLog(request.resource.data);
      allow delete: if isValidId(notificationId);
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidSettings(request.resource.data);
      allow delete: if isValidId(settingId);
    }
  }
}
